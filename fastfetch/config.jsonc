// Minimal fastfetch shown when a new terminal opens (see ~/.zshrc).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "uptime",
    "wm"
  ]
}
